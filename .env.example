# ==============================================================================
# AMC Context Engine / ContextGraph RAG Environment Variables
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# LLM API Keys (At least one is required for query synthesis)
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=contextgraph
NEO4J_DATABASE=neo4j

# Vector Store / FAISS Configuration
VECTOR_STORE_DIR=./data/vector_store
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Query Engine & Routing Configuration
# QUERY_ENGINE: Active serving engine implementation.
#   - v2     : Target V2 Retrieval Orchestrator (hybrid graph + vector retrieval). [Default]
#   - legacy : Emergency hard rollback to procedural legacy RAG (amc_master_legacy).
#   - canary : Split incoming traffic between legacy and v2 based on CANARY_PERCENTAGE.
#   - shadow : Legacy serves synchronously; V2 executes asynchronously for comparison.
QUERY_ENGINE=v2

# CANARY_PERCENTAGE: Traffic routing percentage for canary deployments.
#   - Applicable when QUERY_ENGINE=canary.
#   - Set an integer between 0 and 100 (e.g., 10 routes 10% of traffic to v2, 90% to legacy).
#   - Leave empty or set to 0 when not running a canary split.
CANARY_PERCENTAGE=

# ACTIVE_CORPUS_VERSION: Version tag/identifier for the active document corpus and index namespace.
#   - Specifies the indexed corpus snapshot used by the ingestion pipeline and vector store.
#   - Format: "v2_baseline_YYYYMMDD" or target version tag (e.g., v2_baseline_20260814).
#   - Update this when publishing/switching to a newly ingested corpus version.
ACTIVE_CORPUS_VERSION=

# Frontend Client
VITE_API_BASE=http://localhost:8000
