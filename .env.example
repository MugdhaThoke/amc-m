# ==============================================================================
# AMC Context Engine / ContextGraph Platform - Environment Configuration Template
# Copy this file to '.env' at the project root and customize variables as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Keys & Provider Settings
# ------------------------------------------------------------------------------
# Primary LLM provider API key for query synthesis and Cypher graph generation (REQUIRED)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Anthropic Claude API key for multimodal vision & fallback query synthesis
ANTHROPIC_API_KEY=

# Optional: Google Gemini API key for fallback reasoning or embeddings
GEMINI_API_KEY=

# Active LLM provider: 'groq' | 'anthropic' | 'gemini' (Default: groq)
LLM_PROVIDER=groq

# Primary high-capacity model ID for synthesis (e.g., openai/gpt-oss-120b or llama-3.3-70b-versatile)
LLM_MODEL=openai/gpt-oss-120b

# Fast/lightweight model for quick routing, title extraction, and intent classification
LLM_FAST_MODEL=openai/gpt-oss-20b

# Max tokens generated per LLM response
LLM_MAX_TOKENS=2048

# Client-side rate-limit retry attempts for LLM API calls
LLM_MAX_RETRIES=3


# ------------------------------------------------------------------------------
# 2. Neo4j Knowledge Graph Configuration
# ------------------------------------------------------------------------------
# Bolt protocol URI pointing to active Neo4j database instance
NEO4J_URI=bolt://localhost:7687

# Neo4j database authentication username
NEO4J_USER=neo4j

# Neo4j database authentication password (default configured in docker-compose & local setup)
NEO4J_PASSWORD=contextgraph

# Target database name (default: neo4j)
NEO4J_DATABASE=neo4j


# ------------------------------------------------------------------------------
# 3. Vector Store & Embeddings Configuration
# ------------------------------------------------------------------------------
# Directory path where local FAISS index files and metadata payloads are persisted
VECTOR_STORE_DIR=./data/vector_store

# Pre-trained HuggingFace / FastEmbed embedding model for semantic vector indexing
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Dimensionality of the selected embedding model (384 for BAAI/bge-small-en-v1.5)
EMBEDDING_DIM=384

# Cross-encoder model used to rerank retrieved candidate chunks
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2


# ------------------------------------------------------------------------------
# 4. Backend Server & Runtime Options
# ------------------------------------------------------------------------------
# Server host IP address (0.0.0.0 allows LAN / container access; 127.0.0.1 for local only)
HOST=0.0.0.0

# Port on which the FastAPI application listens
PORT=8000

# Application environment tier: 'development' | 'staging' | 'production' | 'local'
ENVIRONMENT=development

# Logging verbosity level: 'DEBUG' | 'INFO' | 'WARNING' | 'ERROR' | 'CRITICAL'
LOG_LEVEL=INFO

# Log output format: 'text' (human-readable console) | 'json' (structured production logs)
LOG_FORMAT=text

# Suppress HuggingFace hub symlink warning banner on Windows OS (1 = disabled, 0 = enabled)
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Comma-separated list of allowed CORS origins for browser API access
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080


# ------------------------------------------------------------------------------
# 5. Query Engine Routing & Corpus Versioning
# ------------------------------------------------------------------------------
# Active retrieval engine:
#   - v2     : Target V2 Retrieval Orchestrator (hybrid graph + vector retrieval). [Default]
#   - legacy : Emergency hard rollback to procedural legacy RAG (amc_master_legacy).
#   - canary : Split incoming traffic between legacy and v2 based on CANARY_PERCENTAGE.
#   - shadow : Legacy serves synchronously; V2 executes asynchronously for telemetry.
QUERY_ENGINE=v2

# Traffic percentage routed to V2 when QUERY_ENGINE=canary (integer 0 to 100)
CANARY_PERCENTAGE=0

# Corpus snapshot version tag used by ingestion pipeline and index namespace
ACTIVE_CORPUS_VERSION=v2_baseline_20260814

# Master toggle for SSE streaming query response tokens ('true' | 'false')
ENABLE_STREAMING=true


# ------------------------------------------------------------------------------
# 6. Evaluation Tiers & Quality Gates (SEBI Compliance)
# ------------------------------------------------------------------------------
# Enable Tier 2 Natural Language Inference (NLI) semantic alignment evaluation
ENABLE_TIER2_NLI_EVALUATION=true

# NLI confidence score threshold below which responses are flagged for human review (0.0 - 1.0)
TIER2_NLI_CONFIDENCE_THRESHOLD=0.85

# Enable Tier 3 LLM Judge arbitration on high-severity evaluation discrepancies
ENABLE_TIER3_LLM_JUDGE=true

# Minimum severity level triggering Tier 3 arbitration ('LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL')
TIER3_LLM_SEVERITY_THRESHOLD=HIGH


# ------------------------------------------------------------------------------
# 7. Microservices Mode & Circuit Breaker (AMC Feedback & Repair Modules)
# ------------------------------------------------------------------------------
# Enable microservices communication for feedback and repair (false runs in-process)
MICROSERVICES_MODE=false

# Base HTTP URL for the standalone AMC Feedback Loop microservice (default port: 8001)
FEEDBACK_SERVICE_URL=http://localhost:8001

# Base HTTP URL for the standalone AMC Self-Correcting Repair Engine microservice (default port: 8002)
REPAIR_SERVICE_URL=http://localhost:8002

# Timeout in seconds for HTTP calls to external microservices (5.0 to 300.0)
SERVICE_TIMEOUT=30.0

# Master toggle for circuit breaker resilience on inter-service RPC calls
CIRCUIT_BREAKER_ENABLED=true

# Consecutive failures before the circuit breaker trips OPEN to protect upstream services
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Seconds to wait in OPEN state before testing recovery via HALF-OPEN probe
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0


# ------------------------------------------------------------------------------
# 8. Authentication & Security
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret key for signing session tokens (OVERRIDE THIS WITH A RANDOM VALUE IN PRODUCTION)
AUTH_SECRET_KEY=dev-only-insecure-secret-change-me

# Session token TTL duration in minutes for regular logins (480 minutes = 8 hours)
AUTH_SESSION_TTL_MINUTES=480

# Use SQLite database user repository (true) instead of legacy users.json (false)
AUTH_USE_DATABASE=true

# Enforce user-scoped access control and tenant isolation across endpoints
ENABLE_USER_SCOPED_AUTHORIZATION=true


# ------------------------------------------------------------------------------
# 9. Frontend Client Configuration (mf-context-engine React SPA)
# ------------------------------------------------------------------------------
# Target backend API base URL accessed by the React frontend (proxied via Vite dev server)
VITE_API_BASE=http://localhost:8000

# Enable non-blocking feedback resolution status checks in feedback dialogs ('true' | 'false')
VITE_ENABLE_FEEDBACK_STATUS_AWARENESS=true

# Enable expandable sidebar navigation for Admin Feedback Issues & Triage ('true' | 'false')
VITE_FEEDBACK_SIDEBAR_NAV_ENABLED=true

# Enable dedicated 'My Feedback' personal history page in sidebar navigation ('true' | 'false')
VITE_MY_FEEDBACK_PAGE_ENABLED=true

# Enable category breakdown pills in feedback status banner ('true' | 'false')
VITE_FEEDBACK_CATEGORY_BREAKDOWN_BANNER_ENABLED=true


# ------------------------------------------------------------------------------
# 10. Legacy Streamlit Interface (Optional)
# ------------------------------------------------------------------------------
# Port for the legacy Streamlit exploration UI
STREAMLIT_SERVER_PORT=8501

# Bind address for the Streamlit server
STREAMLIT_SERVER_ADDRESS=0.0.0.0
