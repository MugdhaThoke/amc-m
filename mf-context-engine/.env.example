# ==============================================================================
# MF Context Engine (React Frontend) - Environment Configuration Template
# Copy this file to 'mf-context-engine/.env' to override defaults for development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Connection
# ------------------------------------------------------------------------------
# Target URL of the backend FastAPI service.
# NOTE: In local development, the Vite dev server proxies '/api' and '/files'
# to http://127.0.0.1:8000 (see vite.config.js). Set this variable if you need
# to target a remote or non-standard backend directly.
VITE_API_BASE=http://localhost:8000


# ------------------------------------------------------------------------------
# 2. Feedback Feature Flags & Staged Rollout
# ------------------------------------------------------------------------------
# Enable non-blocking feedback status check when opening feedback dialogs (true | false)
# When true: Queries the backend to verify if feedback was already submitted or resolved.
VITE_ENABLE_FEEDBACK_STATUS_AWARENESS=true

# Phase 2: Feedback Issues & Triage sidebar navigation (true | false)
# When true: Expands 'Admin & Governance' into an expandable group with separate
# 'Overview' and 'Feedback Issues & Triage' pages.
VITE_FEEDBACK_SIDEBAR_NAV_ENABLED=true

# Phase 3: 'My Feedback' personal history page (true | false)
# When true: Displays 'My Feedback' in the sidebar workspace navigation for all authenticated users.
VITE_MY_FEEDBACK_PAGE_ENABLED=true

# Phase 4: Category-aware status banner in Feedback Modal / Container (true | false)
# When true: Displays category breakdown badges (top 5 + toggle) in the feedback submission banner.
VITE_FEEDBACK_CATEGORY_BREAKDOWN_BANNER_ENABLED=true
