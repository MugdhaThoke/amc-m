# ============================================================================
# SENSITIVE DATA & CREDENTIALS - HIGHEST PRIORITY
# ============================================================================

# Environment files with secrets
.env
.env.*
!.env.example
!.env.template
.envrc
.envrc.local

# API keys, tokens, and credentials
*.key
*.pem
*.pfx
*.p12
*.jks
*.keystore
credentials.json
secrets.json
creds.json
api_keys.json
token*
!.gitkeep

# Private SSH/SSL certificates and keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pub
private_key
public_key
