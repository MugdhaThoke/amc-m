# ==============================================================================
# AMC ContextGraph Backend API - Environment Configuration Template
# Copy this file to 'backend/.env' (or maintain at project root as '.env')
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Keys & Provider Options
# ------------------------------------------------------------------------------
# Primary Groq API key used for rapid Cypher query generation & answer synthesis (REQUIRED)
# Format: gsk_...
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude API key for secondary fallback & complex multi-turn evaluations
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Google Gemini API key for multimodal reasoning / embeddings
GEMINI_API_KEY=

# Active LLM provider: 'groq' (default), 'anthropic', or 'gemini'
LLM_PROVIDER=groq

# Main synthesis model ID (e.g., openai/gpt-oss-120b or llama-3.3-70b-versatile)
LLM_MODEL=openai/gpt-oss-120b

# Fast model for intent classification, NER pre-processing, and query expansion
LLM_FAST_MODEL=openai/gpt-oss-20b

# Maximum tokens generated per response
LLM_MAX_TOKENS=2048


# ------------------------------------------------------------------------------
# 2. Neo4j Knowledge Graph Configuration
# ------------------------------------------------------------------------------
# Bolt connection URI for the active Neo4j database instance
NEO4J_URI=bolt://localhost:7687

# Neo4j database authentication username
NEO4J_USER=neo4j

# Neo4j database authentication password
NEO4J_PASSWORD=contextgraph

# Target database name (default: neo4j)
NEO4J_DATABASE=neo4j


# ------------------------------------------------------------------------------
# 3. Vector Store & Embeddings Configuration
# ------------------------------------------------------------------------------
# Directory where local FAISS index files and document chunk payloads are persisted
VECTOR_STORE_DIR=./data/vector_store

# Local embedding model identifier (fastembed / sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Dimensionality of the selected embedding model
EMBEDDING_DIM=384

# Cross-encoder model used for reranking candidate retrieved chunks
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2


# ------------------------------------------------------------------------------
# 4. Server & Logging Options
# ------------------------------------------------------------------------------
# Server bind host (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0

# Server listen port
PORT=8000

# Logging verbosity: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO

# Log format: 'text' or 'json'
LOG_FORMAT=text

# Suppress Windows HuggingFace symlinks warning message (1 = suppress, 0 = show)
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Allowed CORS origins for browser clients
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080


# ------------------------------------------------------------------------------
# 5. Microservices Mode & Resilience Patterns
# ------------------------------------------------------------------------------
# Toggle microservices mode: 'true' calls external services, 'false' runs in-process monolithic mode
MICROSERVICES_MODE=false

# URL of the AMC Human Feedback Loop service
FEEDBACK_SERVICE_URL=http://localhost:8001

# URL of the AMC Self-Correcting Repair Engine service
REPAIR_SERVICE_URL=http://localhost:8002

# Timeout for inter-service HTTP calls in seconds
SERVICE_TIMEOUT=30.0

# Master toggle for circuit breaker resilience
CIRCUIT_BREAKER_ENABLED=true

# Failure count threshold to trip circuit breaker open
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Cooldown duration in seconds before testing circuit recovery
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0


# ------------------------------------------------------------------------------
# 6. Query Engine & Corpus Versioning
# ------------------------------------------------------------------------------
# Active query engine implementation:
#   - v2     : Target V2 Hybrid Retrieval Orchestrator [Default]
#   - legacy : Emergency hard rollback to procedural legacy RAG
#   - canary : Split incoming traffic between legacy and v2
#   - shadow : Legacy serves synchronously; V2 runs asynchronously
QUERY_ENGINE=v2

# Percentage of traffic routed to V2 during canary deployments (0 to 100)
CANARY_PERCENTAGE=0

# Active document corpus snapshot version tag (e.g. v2_baseline_20260814)
ACTIVE_CORPUS_VERSION=v2_baseline_20260814

# Master switch for streaming tokens via Server-Sent Events (SSE)
ENABLE_STREAMING=true


# ------------------------------------------------------------------------------
# 7. Evaluation Tiers & Governance Quality Gates
# ------------------------------------------------------------------------------
# Enable Tier 2 Natural Language Inference (NLI) semantic alignment checks
ENABLE_TIER2_NLI_EVALUATION=true

# Threshold below which NLI confidence score fails quality check (0.0 to 1.0)
TIER2_NLI_CONFIDENCE_THRESHOLD=0.85

# Enable Tier 3 LLM Judge arbitration on high-severity evaluation discrepancies
ENABLE_TIER3_LLM_JUDGE=true

# Minimum severity triggering Tier 3 arbitration ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL')
TIER3_LLM_SEVERITY_THRESHOLD=HIGH


# ------------------------------------------------------------------------------
# 8. Authentication & Authorization
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret key for signing session tokens (CHANGE THIS IN PRODUCTION)
AUTH_SECRET_KEY=dev-only-insecure-secret-change-me

# Session token TTL duration in minutes (480 minutes = 8 hours)
AUTH_SESSION_TTL_MINUTES=480

# Use SQLite database user repository (true) instead of legacy users.json (false)
AUTH_USE_DATABASE=true

# Master feature flag for tenant isolation and user-scoped authorization
ENABLE_USER_SCOPED_AUTHORIZATION=true
